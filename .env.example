# Copie este archivo a .env.local y complete los valores. Nunca suba .env.local al repositorio.

# Supabase → Project Settings → API Keys
SUPABASE_URL=https://su-proyecto.supabase.co
# Llave secreta (sb_secret_...). Solo se usa en el servidor; nunca en el navegador.
SUPABASE_SECRET_KEY=

# Cadena aleatoria larga para firmar la cookie de sesión (por ejemplo: openssl rand -hex 32)
SESSION_SECRET=

# Clave para el botón «Reiniciar datos de demostración». Si se deja vacía, no se pide clave.
CLAVE_REINICIO=

# Contraseña de la coordinación de EIRA para entrar al tablero. Si se deja vacía, nadie puede entrar como EIRA.
EIRA_CONTRASENA=
